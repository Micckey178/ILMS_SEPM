# ILMS — Multi-Laboratory Inventory and Lab Management System
# Firebase Web Client Configuration
# Replace with values from your Firebase Project Console -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Local Development / Firebase Emulator Mode (Set to true to connect to local emulators)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=localhost
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Demo Mode Toggle: When true, ILMS initializes with rich seed data for 7+ laboratories in memory/indexedDB if real credentials are not set
VITE_ENABLE_DEMO_FALLBACK=true
