rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isLabManager(labId) {
      return isAuthenticated() && (
        isAdmin() ||
        (getUserData().role == 'labManager' && (labId in getUserData().assignedLabs || getUserData().assignedLabId == labId))
      );
    }

    function isTechnician(labId) {
      return isAuthenticated() && (
        isLabManager(labId) ||
        (getUserData().role == 'technician' && (labId in getUserData().assignedLabs || getUserData().assignedLabId == labId))
      );
    }

    function isFaculty(labId) {
      return isAuthenticated() && (
        isTechnician(labId) ||
        getUserData().role == 'faculty'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Organizations & Campuses
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /campuses/{campusId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Users Collection - Protect from privilege self-escalation
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Only Admins can modify roles or permissions. Users can update their own personal profile fields
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role in ['student', 'faculty'])
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) && request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Laboratories & Lab Configurations
    match /laboratories/{labId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isLabManager(labId);
    }

    match /laboratoryConfigurations/{labId} {
      allow read: if isAuthenticated();
      allow write: if isLabManager(labId);
    }

    // Universal Inventory Items
    match /inventoryItems/{itemId} {
      allow read: if isAuthenticated();
      // Technicians, Managers, and Admins can create/edit inventory
      allow create: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
      allow update: if isAuthenticated() && (
        isTechnician(resource.data.laboratoryId) ||
        // Cloud functions / trusted operations
        request.auth.token.role == 'service'
      );
      allow delete: if isAuthenticated() && isLabManager(resource.data.laboratoryId);
    }

    // Stock Movement Ledger - Immutable audit records
    match /stockMovements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
      allow update, delete: if false; // Movements are append-only audit records
    }

    // Equipment Assets & Kits
    match /equipmentAssets/{assetId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
      allow delete: if isAuthenticated() && isLabManager(resource.data.laboratoryId);
    }

    match /equipmentKits/{kitId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
      allow delete: if isAuthenticated() && isLabManager(resource.data.laboratoryId);
    }

    // Bookings & Scheduling
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isTechnician(request.resource.data.laboratoryId)
      );
      allow update: if isAuthenticated() && (
        // Requester can cancel their own pending booking
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'cancelled') ||
        // Only managers/technicians can approve, reject, or modify booking slots
        isTechnician(resource.data.laboratoryId)
      );
      allow delete: if isAuthenticated() && isLabManager(resource.data.laboratoryId);
    }

    // Equipment Issue & Return Transactions
    match /issueReturnTransactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        // Student/faculty requesting an item OR technician issuing directly
        request.resource.data.borrowerId == request.auth.uid ||
        isTechnician(request.resource.data.laboratoryId)
      );
      allow update: if isAuthenticated() && isTechnician(resource.data.laboratoryId);
      allow delete: if isAdmin();
    }

    // Maintenance & Calibration
    match /maintenanceRecords/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
    }

    match /calibrationRecords/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
    }

    // Specialized Laboratory Data
    match /chemicalBatches/{batchId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
    }

    match /samples/{sampleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isFaculty(request.resource.data.laboratoryId);
    }

    match /experiments/{experimentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isFaculty(request.resource.data.laboratoryId);
    }

    match /softwareAssets/{softwareId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
    }

    // Procurement & Purchase Requests
    match /purchaseRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.requestedBy == request.auth.uid ||
        isTechnician(request.resource.data.laboratoryId)
      );
      // Requester cannot approve their own purchase request
      allow update: if isAuthenticated() && (
        (resource.data.requestedBy == request.auth.uid && request.resource.data.status == 'cancelled') ||
        (isLabManager(resource.data.laboratoryId) && resource.data.requestedBy != request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /purchaseOrders/{orderId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isLabManager(request.resource.data.laboratoryId);
    }

    match /goodsReceipts/{receiptId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTechnician(request.resource.data.laboratoryId);
    }

    // Safety & Incident Management
    match /incidentTickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isTechnician(resource.data.laboratoryId) ||
        resource.data.reportedBy == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.targetUserId == request.auth.uid ||
        resource.data.targetRole == getUserData().role ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.targetUserId == request.auth.uid;
    }

    // Audit Logs - Read by authorized staff, write only appended
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (isLabManager(resource.data.laboratoryId) || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strictly immutable
    }

    // System Settings
    match /systemSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
